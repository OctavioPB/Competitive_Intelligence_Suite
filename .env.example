# ── Claude API — required for Modules 04 (Battlecard) and optionally 05 (Alerts) ──
ANTHROPIC_API_KEY=

# ── Data sources ─────────────────────────────────────────────────────────────
# NewsAPI — https://newsapi.org
NEWSAPI_KEY=

# Reddit PRAW — https://www.reddit.com/prefs/apps (Personal Use Script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RivalSense/1.0 by your_reddit_username

# ── Alerts ───────────────────────────────────────────────────────────────────
# Slack incoming webhook URL — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Email digests (optional) ─────────────────────────────────────────────────
SENDGRID_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (dev): just the filename (e.g. rivalsense.db)
# PostgreSQL (prod): postgresql://user:password@host:5432/dbname
DATABASE_URL=rivalsense.db

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set to true to load from rivalsense_demo.db (no scraping, instant startup)
DEMO_MODE=false
