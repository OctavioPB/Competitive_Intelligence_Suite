# ── Claude API — required for M04, M07, M08, M09 and optionally M05 ────────────
ANTHROPIC_API_KEY=
# Optional: override the model used by every module (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# ── Data sources ─────────────────────────────────────────────────────────────
# NewsAPI — https://newsapi.org
NEWSAPI_KEY=

# Reddit PRAW — https://www.reddit.com/prefs/apps (Personal Use Script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RivalSense/1.0 by your_reddit_username

# ── Alerts ───────────────────────────────────────────────────────────────────
# Slack incoming webhook URL — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Email digests (optional) ─────────────────────────────────────────────────
SENDGRID_API_KEY=
# Recipient of the scheduled weekly digest email
DIGEST_EMAIL=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (dev): just the filename (e.g. rivalsense.db)
# PostgreSQL (prod): postgresql://user:password@host:5432/dbname
DATABASE_URL=rivalsense.db

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set to true to load from rivalsense_demo.db (no scraping, instant startup)
DEMO_MODE=false

# ── API server ───────────────────────────────────────────────────────────────
# Run the daily scrape / alert / weekly digest jobs inside the API process.
# Off by default; always off in demo mode.
ENABLE_SCHEDULER=false
# Comma-separated browser origins allowed to call the API directly
# (not needed for the Vite dev server, which proxies /api).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
